<properties>
	<!-- REUSABLE ARTWORK OPTION SETS -->
	<includes>
		<include name="artwork_options">
			<option value="portraiticon" label="$LOCALIZE[31248]">
				<condition>!widget=info</condition>
			</option>
			<option value="squareicon" label="$LOCALIZE[31260]" />
			<option value="landscapeicon" label="$LOCALIZE[31250]" />
			<option value="fanart" label="$LOCALIZE[20445]">
				<condition>!widgetType=favourites + !widgetType=picture + !widgetTarget=pvr</condition>
			</option>
			<option value="thumb" label="$LOCALIZE[39114]">
				<condition>[widget=library | widget=playlist] + widgetType=episodes</condition>
			</option>
			<option value="landscape" label="$LOCALIZE[31201]">
				<condition>[widget=library | widget=playlist] + [widgetType=movies | widgetType=episodes | widgetType=tvshows | widgetType=musicvideos | widgetType=artists]</condition>
			</option>
			<option value="clearart" label="$LOCALIZE[31165]">
				<condition>[widget=library | widget=playlist] + [widgetType=movies | widgetType=episodes | widgetType=tvshows | widgetType=musicvideos | widgetType=artists]</condition>
			</option>
			<option value="clearlogo" label="$LOCALIZE[31202]">
				<condition>[widget=library | widget=playlist] + [widgetType=movies | widgetType=episodes | widgetType=tvshows | widgetType=musicvideos | widgetType=artists]</condition>
			</option>
		</include>
		<!-- Labels use $NUMBER[] so the addon's resolve_label() renders them as literal numbers.
         A plain "10" label is auto-localized by Kodi (10->"Weather", 15->"Friday"); the value
         attr is the raw number actually stored in widgetLimit.N. -->
		<include name="limit_options">
			<option value="1" label="$NUMBER[1]" />
			<option value="2" label="$NUMBER[2]" />
			<option value="3" label="$NUMBER[3]" />
			<option value="4" label="$NUMBER[4]" />
			<option value="5" label="$NUMBER[5]" />
			<option value="6" label="$NUMBER[6]" />
			<option value="7" label="$NUMBER[7]" />
			<option value="8" label="$NUMBER[8]" />
			<option value="9" label="$NUMBER[9]" />
			<option value="10" label="$NUMBER[10]" />
			<option value="15" label="$NUMBER[15]" />
			<option value="20" label="$NUMBER[20]" />
			<option value="25" label="$NUMBER[25]" />
			<option value="50" label="$NUMBER[50]" />
			<option value="100" label="$NUMBER[100]" />
		</include>
	</includes>

	<!-- PROPERTY SCHEMAS -->
	<property name="widget" type="widget" />
	<property name="background" type="background" />
	<property name="covercase" type="toggle" value="true" templateonly="true" />
	<property name="widgetPath" type="text" />
