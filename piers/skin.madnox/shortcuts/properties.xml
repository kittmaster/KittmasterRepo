	<property name="widgetStyle" type="options">
		<options>
			<option value="big" label="$LOCALIZE[31210]" />
			<option value="medium" label="$LOCALIZE[601]" />
			<option value="small" label="$LOCALIZE[1438]" />
		</options>
	</property>

	<property name="widgetArtwork" type="options">
		<options>
			<include content="artwork_options" />
		</options>
	</property>

	<property name="widgetLimit" type="options">
		<options>
			<include content="limit_options" />
		</options>
	</property>

	<property name="widgetCaseMusic" type="toggle" value="true" />
	<property name="widgetCaseVideo" type="toggle" value="true" />
